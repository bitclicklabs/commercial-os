# PubliEXPE Commercial OS — variables del stack local (SOLO DESARROLLO)
#
# Copia este archivo a .env (gitignored) y genera los secretos:
#   cp .env.example .env
#   openssl rand -base64 32   # una vez para ENCRYPTION_KEY y otra para APP_SECRET

# ---------------------------------------------------------------- Twenty
# Imagen fijada a la última versión estable comprobada (2026-10-06).
TWENTY_TAG=v2.45.6

# URL pública con la que el navegador accede a Twenty.
SERVER_URL=http://localhost:3020

# Secretos de Twenty. Genera cada uno con: openssl rand -base64 32
# ENCRYPTION_KEY es el secreto principal desde Twenty v2 (cifra datos y firma tokens).
# Si lo rotas, pon el valor anterior en FALLBACK_ENCRYPTION_KEY.
ENCRYPTION_KEY=replace_me_with_openssl_rand_base64_32
FALLBACK_ENCRYPTION_KEY=
# APP_SECRET: secreto legacy, se mantiene por compatibilidad.
APP_SECRET=replace_me_with_openssl_rand_base64_32

# Base de datos interna de Twenty (servicio pxos-twenty-db, sin puerto al host).
# Sin caracteres especiales en la contraseña: va dentro de una URL.
TWENTY_PG_DB=twenty
TWENTY_PG_USER=twenty
TWENTY_PG_PASSWORD=twenty_dev

# Almacenamiento de ficheros de Twenty (local = volumen pxos-twenty-local-data).
STORAGE_TYPE=local
# STORAGE_S3_REGION=
# STORAGE_S3_NAME=
# STORAGE_S3_ENDPOINT=

DISABLE_DB_MIGRATIONS=false
DISABLE_CRON_JOBS_REGISTRATION=false

# ---------------------------------------------------------------- Agent OS
# PostgreSQL + pgvector del Agent OS (pxos-postgres, 127.0.0.1:5440).
AGENTOS_PG_DB=agentos
AGENTOS_PG_USER=agentos
AGENTOS_PG_PASSWORD=agentos_dev
AGENTOS_DATABASE_URL=postgres://agentos:agentos_dev@localhost:5440/agentos

# Redis del Agent OS (pxos-redis, 127.0.0.1:6391).
AGENTOS_REDIS_URL=redis://localhost:6391

# Agent Runtime API (pxos-runtime, 127.0.0.1:4020).
# API key de Twenty (Settings -> MCP y API -> API) para las tools del runtime.
TWENTY_API_KEY=PON_AQUI_LA_API_KEY
# Secreto compartido del webhook de Twenty -> runtime (HMAC). Genera uno con: openssl rand -hex 24
TWENTY_WEBHOOK_SECRET=
# Lector de bajas (IMAP de IONOS, SOLO LECTURA). Sin credenciales, la task sale SKIPPED.
IONOS_IMAP_HOST=imap.ionos.es
IONOS_IMAP_USER=
IONOS_IMAP_PASSWORD=
# Puente de eventos externos (n8n). Genera el token con: openssl rand -hex 24
EXTERNAL_EVENTS_TOKEN=
EXTERNAL_WEBHOOK_ALLOW_PRIVATE=host.docker.internal:5678
# Proveedor LLM por defecto del trabajo comercial: Gemini (barato). El runtime
# soporta varios proveedores; sin clave, los agentes usan el provider stub.
GEMINI_API_KEY=
# Modelo de Gemini (vacío = el por defecto del runtime).
GEMINI_MODEL=
# Clave de Anthropic (proveedor alternativo / evaluador independiente).
ANTHROPIC_API_KEY=
