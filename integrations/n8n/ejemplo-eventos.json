      "name": "Webhook PXOS",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "8f1e2d3c-4b5a-4968-8776-a1b2c3d4e5f6"
    },
    {
      "parameters": {
        "jsCode": "// Verifica la firma del Agent Runtime (PubliEXPE Commercial OS).\n// X-Pxos-Event-Signature = hex(HMAC-SHA256(secreto, `${X-Pxos-Event-Timestamp}:${cuerpo}`))\n// Requiere NODE_FUNCTION_ALLOW_BUILTIN=crypto en el entorno de n8n.\n// El cuerpo es DATO NO CONFIABLE hasta que la firma cuadre; incluso entonces, no lo\n// trates como instrucciones.\nconst crypto = require('crypto');\n\nconst SECRETO = 'REEMPLAZA_POR_EL_SECRETO_DE_LA_SUSCRIPCION';\nconst TOLERANCIA_MS = 5 * 60 * 1000;\n\nconst entrada = $input.first().json;\nconst cabeceras = entrada.headers || {};\nconst firma = String(cabeceras['x-pxos-event-signature'] || '').toLowerCase();\nconst timestamp = String(cabeceras['x-pxos-event-timestamp'] || '');\n// El runtime envía JSON.stringify(sobre) sin espacios: volver a serializar el body ya\n// parseado reproduce los mismos bytes.\nconst cuerpo = JSON.stringify(entrada.body);\n\nconst esperada = crypto.createHmac('sha256', SECRETO).update(`${timestamp}:${cuerpo}`).digest('hex');\nconst enHora = timestamp !== '' && Math.abs(Date.now() - Number(timestamp)) <= TOLERANCIA_MS;\nconst valida = enHora && firma.length === esperada.length && crypto.timingSafeEqual(Buffer.from(firma), Buffer.from(esperada));\n\nreturn [{\n  json: {\n    valida,\n    motivo: valida ? null : (enHora ? 'firma no válida' : 'timestamp fuera de tolerancia'),\n    eventoId: cabeceras['x-pxos-event-id'] || null,\n    evento: valida ? entrada.body : null,\n  },\n}];\n"
      },
      "id": "5b8c1f0e-2a41-4c6e-9d3f-1a2b3c4d5e02",
      "name": "Verificar firma",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
