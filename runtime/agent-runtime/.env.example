# PubliEXPE Commercial OS - Agent Runtime
# Copia a .env para desarrollo local. Los valores por defecto apuntan a los
# contenedores pxos-postgres (5440) y pxos-redis (6391) publicados en 127.0.0.1.

# Rol del proceso: all (API + worker + scheduler en el mismo proceso), api, worker o scheduler
RUNTIME_ROLE=all

# API HTTP
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=4020
LOG_LEVEL=info

# PostgreSQL (Agent OS)
DATABASE_URL=postgres://agentos:agentos_dev@127.0.0.1:5440/agentos

# Redis (BullMQ)
REDIS_URL=redis://127.0.0.1:6391
QUEUE_NAME=pxos-agent-runs
WORKER_CONCURRENCY=4

# Scheduler y recuperación de huérfanos (milisegundos)
SCHEDULER_SYNC_INTERVAL_MS=60000
RECONCILE_INTERVAL_MS=60000
RECONCILE_GRACE_MS=120000
CONCURRENCY_DEFER_MS=2000
STALLED_INTERVAL_MS=30000
MAX_STALLED_COUNT=1

# Multi-tenancy (C6): tenant por defecto si la petición no envía x-tenant-id
DEFAULT_TENANT_ID=publiexpe

# Proveedor LLM por defecto para agentes sin model_provider explícito: stub | anthropic
DEFAULT_MODEL_PROVIDER=stub
# Solo necesario si algún agente usa model_provider=anthropic
ANTHROPIC_API_KEY=
