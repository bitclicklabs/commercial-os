# PubliEXPE Commercial OS - Agent Runtime
# Copia a .env para desarrollo local. Los valores por defecto apuntan a los
# contenedores pxos-postgres (5440) y pxos-redis (6391) publicados en 127.0.0.1.

# Rol del proceso: all (API + worker + scheduler en el mismo proceso), api, worker o scheduler
RUNTIME_ROLE=all

# API HTTP
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=4020
LOG_LEVEL=info

# PostgreSQL (Agent OS)
DATABASE_URL=postgres://agentos:agentos_dev@127.0.0.1:5440/agentos

# Redis (BullMQ)
REDIS_URL=redis://127.0.0.1:6391
QUEUE_NAME=pxos-agent-runs
WORKER_CONCURRENCY=4

# Scheduler y recuperación de huérfanos (milisegundos)
SCHEDULER_SYNC_INTERVAL_MS=60000
RECONCILE_INTERVAL_MS=60000
RECONCILE_GRACE_MS=120000
CONCURRENCY_DEFER_MS=2000
STALLED_INTERVAL_MS=30000
MAX_STALLED_COUNT=1

# Multi-tenancy (C6): tenant por defecto si la petición no envía x-tenant-id
DEFAULT_TENANT_ID=publiexpe

# Proveedor LLM por defecto para agentes sin model_provider explícito: stub | anthropic | gemini
DEFAULT_MODEL_PROVIDER=stub
# Solo necesario si algún agente usa model_provider=anthropic
ANTHROPIC_API_KEY=

# Google Gemini (proveedor de trabajo del Prospector, model_provider=gemini).
# API key de Google AI Studio. Sin ella, las llamadas fallan con GEMINI_NOT_CONFIGURED
# y el test en vivo del Prospector se salta.
GEMINI_API_KEY=
# Modelo por defecto si la agent_version no fija uno de Gemini. Vacío = gemini-flash-latest.
# Prioridad: agent_version.model > GEMINI_MODEL > gemini-flash-latest
GEMINI_MODEL=

# Twenty CRM (tools find_company, upsert_company, create_signal...).
# En local, la API de Twenty se publica en 3020; dentro de pxos-net es http://pxos-twenty:3000.
TWENTY_BASE_URL=http://localhost:3020
# API key de Twenty (Settings > APIs & Webhooks). Sin ella, las tools de Twenty
# responden TWENTY_NOT_CONFIGURED y los tests de integración de Twenty se saltan.
TWENTY_API_KEY=
# Timeout por petición a Twenty, en milisegundos
TWENTY_TIMEOUT_MS=10000

# fetch_url (tool READ del modo scout del Prospector). Listas de dominios separadas por
# comas; cada dominio incluye sus subdominios. Allowlist vacía = cualquier host público.
# Las IP privadas, loopback y link-local se rechazan siempre (también tras redirecciones).
FETCH_URL_ALLOWLIST=
FETCH_URL_DENYLIST=
# Puertos permitidos en las URL. Vacío = 80,443,8080,8443
FETCH_URL_ALLOWED_PORTS=
