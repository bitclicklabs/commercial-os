# PubliEXPE Commercial OS - Agent Runtime
# Copia a .env para desarrollo local. Los valores por defecto apuntan a los
# contenedores pxos-postgres (5440) y pxos-redis (6391) publicados en 127.0.0.1.

# Rol del proceso: all (API + worker + scheduler en el mismo proceso), api, worker o scheduler
RUNTIME_ROLE=all

# API HTTP
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=4020
LOG_LEVEL=info

# PostgreSQL (Agent OS)
DATABASE_URL=postgres://agentos:agentos_dev@127.0.0.1:5440/agentos

# Redis (BullMQ)
REDIS_URL=redis://127.0.0.1:6391
QUEUE_NAME=pxos-agent-runs
WORKER_CONCURRENCY=4

# Scheduler y recuperación de huérfanos (milisegundos)
SCHEDULER_SYNC_INTERVAL_MS=60000
# Tenants cuyas tareas programa el scheduler (CRON, INTERVAL, ONCE y triggers EVENT), separados
# por comas. Vacío = DEFAULT_TENANT_ID. "*" = todos los tenants: SOLO para entornos de test.
# Las tareas de otros tenants se ignoran (un WARN agregado por pasada); POST /tasks/:id/run sigue funcionando.
SCHEDULER_TENANTS=
# Catch-up tras una parada: slots perdidos que recupera cada tarea CRON/INTERVAL (los más
# recientes, mínimo 1) y antigüedad máxima de un slot recuperable (por defecto 48 h).
CATCHUP_MAX_SLOTS=1
CATCHUP_MAX_AGE_MS=172800000
RECONCILE_INTERVAL_MS=60000
RECONCILE_GRACE_MS=120000
# Latido de un TaskRun RUNNING (updated_at); muy por debajo de RECONCILE_GRACE_MS. 0 = desactivado
RUN_HEARTBEAT_MS=30000
CONCURRENCY_DEFER_MS=2000
STALLED_INTERVAL_MS=30000
MAX_STALLED_COUNT=1

# Event bus (cola {QUEUE_NAME}-events). Profundidad máxima de una cadena de tareas
# disparadas por eventos y re-publicador de eventos sin despachar (milisegundos).
EVENT_CHAIN_MAX_DEPTH=5
EVENT_REPUBLISH_INTERVAL_MS=30000
EVENT_REPUBLISH_GRACE_MS=15000
EVENT_CONSUMER_CONCURRENCY=4

# Multi-tenancy (C6): tenant por defecto si la petición no envía x-tenant-id
DEFAULT_TENANT_ID=publiexpe

# Proveedor LLM por defecto para agentes sin model_provider explícito: stub | anthropic | gemini
DEFAULT_MODEL_PROVIDER=stub
# Solo necesario si algún agente usa model_provider=anthropic
ANTHROPIC_API_KEY=

# Google Gemini (proveedor de trabajo del Prospector, model_provider=gemini).
# API key de Google AI Studio. Sin ella, las llamadas fallan con GEMINI_NOT_CONFIGURED
# y el test en vivo del Prospector se salta.
GEMINI_API_KEY=
# Modelo por defecto si la agent_version no fija uno de Gemini. Vacío = gemini-flash-latest.
# Prioridad: agent_version.model > GEMINI_MODEL > gemini-flash-latest
# Fallback ANTIGUO del routing: MODEL_ROUTE_<ROL> gana (aviso en el log si discrepan).
GEMINI_MODEL=

# Juez de los evaluadores automáticos (pnpm evaluate, LLM_JUDGE). Tiene que ser un modelo
# distinto del ejecutor del agente. Vacío = gemini-pro-latest.
# Fallback ANTIGUO del rol judge: MODEL_ROUTE_JUDGE gana (aviso en el log si discrepan).
JUDGE_MODEL=

# Routing de modelos por rol (README "Routing de modelos por rol"): proveedor:modelo.
# Vacío = el modelo de la versión del agente (ejecutores) o la tabla del código.
# Se validan al arrancar: formato, proveedor (stub|anthropic|gemini) y precio conocido.
# Ejemplo: MODEL_ROUTE_JUDGE=anthropic:claude-sonnet-5-5 (necesita ANTHROPIC_API_KEY)
MODEL_ROUTE_EXECUTOR_CHEAP=
MODEL_ROUTE_EXECUTOR_REASONER=
MODEL_ROUTE_TRIAGE=
MODEL_ROUTE_JUDGE=
MODEL_ROUTE_OPTIMIZER=

# Twenty CRM (tools find_company, upsert_company, create_signal...).
# En local, la API de Twenty se publica en 3020; dentro de pxos-net es http://pxos-twenty:3000.
TWENTY_BASE_URL=http://localhost:3020
# API key de Twenty (Settings > APIs & Webhooks). Sin ella, las tools de Twenty
# responden TWENTY_NOT_CONFIGURED y los tests de integración de Twenty se saltan.
TWENTY_API_KEY=
# Timeout por petición a Twenty, en milisegundos
TWENTY_TIMEOUT_MS=10000
# Tiempo máximo (ms) que el worker retiene un run con tools de Twenty mientras Twenty
# no responde a /healthz (p. ej. al arrancar el host). Pasado, el run arranca igualmente.
# 0 desactiva la espera.
TWENTY_WAIT_MAX_MS=600000

# Evaluador HUMAN: webhook de Twenty (POST /webhooks/twenty).
# Secreto compartido (mínimo 16 caracteres): Twenty firma cada envío con él (HMAC-SHA256).
# Genera uno con: openssl rand -hex 32. Sin él, el webhook responde 503.
TWENTY_WEBHOOK_SECRET=
# Destino que registra `pnpm register:webhook` si no pasas --url. Desde los contenedores de
# Twenty el runtime es http://pxos-runtime:4020; con el runtime en el host usa
# http://host.docker.internal:<puerto>/webhooks/twenty y RUNTIME_HOST=0.0.0.0.
# Twenty necesita OUTBOUND_HTTP_ALLOWED_INTERNAL_HOSTS=pxos-runtime,host.docker.internal.
TWENTY_WEBHOOK_TARGET_URL=http://pxos-runtime:4020/webhooks/twenty
# Ventana (ms) en la que no se registra dos veces el mismo veredicto (sujeto, feedback, estado destino)
EVALUATION_DEDUPE_WINDOW_MS=600000

# Eventos externos (n8n, Twenty): consulta docs/n8n-integracion.md.
# Token Bearer de POST /events/external (mínimo 16 caracteres). Genera uno con:
# openssl rand -hex 32. Vacío = la ruta responde 503.
EXTERNAL_EVENTS_TOKEN=
# Prefijos permitidos en el type de los eventos externos, separados por comas.
# Nunca task., agent. ni evaluation. (el runtime no arranca si alguno los cubre).
EXTERNAL_EVENT_TYPE_PREFIXES=ext.
# Webhooks salientes (event_subscriptions): destinos que pueden resolver a IP privada o
# loopback. Lista de host o host:puerto, coincidencia exacta (sin subdominios). Vacío =
# solo IP públicas. Para un n8n local en desarrollo:
#   runtime en Docker y n8n en el host -> host.docker.internal:5678
#   runtime en el host (pnpm dev)      -> localhost:5678
# Defínela en los procesos api (valida la URL) y scheduler (entrega). No la uses en
# producción salvo para destinos internos concretos.
EXTERNAL_WEBHOOK_ALLOW_PRIVATE=
# Entrega de webhooks salientes: timeout por intento, base del backoff exponencial entre
# los 3 intentos y entregas simultáneas (milisegundos salvo la concurrencia)
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
WEBHOOK_DELIVERY_BACKOFF_MS=5000
WEBHOOK_DELIVERY_CONCURRENCY=4

# fetch_url (tool READ del modo scout del Prospector). Listas de dominios separadas por
# comas; cada dominio incluye sus subdominios. Allowlist vacía = cualquier host público.
# Las IP privadas, loopback y link-local se rechazan siempre (también tras redirecciones).
FETCH_URL_ALLOWLIST=
FETCH_URL_DENYLIST=
# Puertos permitidos en las URL. Vacío = 80,443,8080,8443
FETCH_URL_ALLOWED_PORTS=

# render_url (tool READ del modo scout): servicio pxos-renderer (services/renderer/) que
# renderiza catálogos JavaScript con Chromium. Sin definir = http://pxos-renderer:3000
# (dentro de pxos-net). En desarrollo, http://127.0.0.1:4030 si el renderer se arranca con
# `pnpm dev` o está publicado ahí. Vacío u "off" = desactivado: render_url devuelve
# RENDERER_NOT_CONFIGURED y el scout sigue sin renderizar.
RENDERER_URL=http://127.0.0.1:4030

# Ventana de lead time (tanda 18): el Prospector solo prospecta ferias a las que faltan entre
# LEADTIME_MIN_DAYS y LEADTIME_MAX_DAYS días (ambos incluidos, fecha a fecha en Europe/Madrid).
# Por debajo del mínimo no hay plazo de producción; las hipótesis PROPOSED de esas ferias caducan.
# Valores no válidos (o mínimo > máximo) vuelven a 45 / 210.
LEADTIME_MIN_DAYS=45
LEADTIME_MAX_DAYS=210

# Catalog Service (docs/catalog-service.md, contrato v1.1). Apagado por defecto: solo "true"
# lo enciende. Con false las tools catalog_* no se exponen y no se comprueba la salud.
CATALOG_ENABLED=false
# stub (fixtures de fixtures/catalog/, sin red; productos FICTICIOS) o http (conector real por VPN)
CATALOG_PROVIDER=stub
# SOLO el origen del conector (https://host[:puerto]); el cliente añade /api/catalog/v1. Es el único
# host exento del guard anti-SSRF (host y puerto exactos). Obligatoria con CATALOG_PROVIDER=http.
CATALOG_BASE_URL=
# Token Bearer de solo lectura (pxcat_...). Secreto: solo en .env, nunca en el repositorio.
CATALOG_API_TOKEN=

# ContactFinder, fase 2 (enriquecimiento externo, solo para hipótesis VALIDATED sin contacto
# publicado en la web de la empresa). Apagado por defecto: "stub" solo conoce dominios de
# prueba reservados (.example) y nunca devuelve datos de empresas reales. "hunter" usa la
# Domain Search de Hunter.io (sin ENRICH_API_KEY vuelve al stub). Por debajo de confianza 0,7
# la dirección solo queda en el Research, nunca en «Email to».
ENRICH_PROVIDER=stub
# API key de Hunter.io. Secreto: solo en .env.
ENRICH_API_KEY=
# Consultas por día local (Europe/Madrid) y proceso; contador en memoria. Por defecto 25.
ENRICH_MAX_LOOKUPS_PER_DAY=25
# Coste anotado por consulta real (euros). Por defecto 0.10.
ENRICH_COST_PER_LOOKUP_EUR=0.10

# Inbound de bajas (BajasAgent, tarea process-unsubscribes cada 2 horas). Buzón IONOS en
# SOLO LECTURA por IMAP (EXAMINE + BODY.PEEK): el runtime nunca envía, responde, mueve ni
# borra correos. Sin usuario o contraseña la tarea termina SKIPPED con el motivo y el test en
# vivo se salta. Host y puerto de IONOS España: imap.ionos.es, 993 con SSL/TLS.
IONOS_IMAP_HOST=imap.ionos.es
IONOS_IMAP_PORT=993
IONOS_IMAP_USER=
IONOS_IMAP_PASSWORD=
# Carpeta a leer (por defecto INBOX)
IONOS_IMAP_MAILBOX=INBOX

# Métricas en Twenty (docs/estudio-dashboard-twenty.md). El rol scheduler escribe un registro
# agentOsDailyMetric por día local (Europe/Madrid) con las cifras de /metrics/summary; la
# página nativa «Agent OS · Métricas» de la App los grafica. Requiere la App sincronizada
# (objeto agentOsDailyMetric) y TWENTY_API_KEY. Desactivado por defecto: true para activarlo.
# Relleno inicial del histórico: pnpm metrics:sync-twenty --days=30
METRICS_TWENTY_SYNC_ENABLED=false
# Cada cuánto se refrescan los últimos días (ms; mínimo 60000, por defecto 15 minutos)
METRICS_TWENTY_SYNC_INTERVAL_MS=900000
# Días refrescados en cada pasada, hoy incluido (1 a 62; por defecto 2 para cerrar el de ayer)
METRICS_TWENTY_SYNC_DAYS=2

# Retención de trazas sin pérdida (pnpm traces:archive). Antigüedad en días a partir de
# la que se archivan los payloads pesados de trace_steps (por defecto 90) y directorio de los
# ficheros <tenant>/<YYYY-MM>.jsonl.gz (por defecto ./data/trace-archive, relativo al proceso).
# GET /traces/:id?rehydrate=true lee de aquí: en Docker, monta este directorio como volumen.
TRACE_RETENTION_DAYS=90
TRACE_ARCHIVE_DIR=./data/trace-archive
# Archivado programado en el rol scheduler (misma función que la CLI; nunca borra). Desactivado
# por defecto: true para activarlo. Cada pasada con trabajo deja traces.archive en audit_log.
TRACE_ARCHIVE_ENABLED=false
# Cada cuánto (ms; mínimo 60000, por defecto 24 h). La primera pasada, 1 min tras arrancar.
TRACE_ARCHIVE_INTERVAL_MS=86400000

# Skill Optimizer programado en el rol scheduler (README "Programado"). Solo encola el mismo run
# que POST /optimizer/skills/:name/run; nunca activa ni promueve. Desactivado por defecto.
# Un disparo como mucho por ventana del CRON (también tras reiniciar); cada encolado deja
# optimizer.scheduled_run en audit_log. Sin datos, el run acaba en BLOCKED_NO_DATA sin coste.
OPTIMIZER_SCHEDULE_ENABLED=false
# CRON de 5 campos en hora de Europe/Madrid (por defecto, miércoles a las 09:00).
OPTIMIZER_SCHEDULE_CRON=0 9 * * 3
# Skills separadas por comas (solo las que tienen runner de experimentos).
OPTIMIZER_SCHEDULE_SKILLS=prospector-event-exhibitors
