{
  "name": "@pxos/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "PubliEXPE Commercial OS - Agent Runtime (API + worker)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:api": "tsx watch --env-file-if-exists=.env src/main.ts --role=api",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/main.ts --role=worker",
    "dev:scheduler": "tsx watch --env-file-if-exists=.env src/main.ts --role=scheduler",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env src/seed/index.ts",
    "register:webhook": "tsx --env-file-if-exists=.env src/integrations/twenty/register-webhook.ts",
    "twenty:send-workflow": "tsx --env-file-if-exists=.env src/integrations/twenty/create-send-workflow.ts",
    "cleanup:archive-test-agents": "tsx --env-file-if-exists=.env src/maintenance/archive-test-agents.ts",
    "metrics:sync-twenty": "tsx --env-file-if-exists=.env src/maintenance/sync-metrics-to-twenty.ts",
    "skill:candidate": "tsx --env-file-if-exists=.env scripts/skill-candidate.ts",
    "skill:compare": "tsx --env-file-if-exists=.env scripts/skill-compare.ts",
    "evaluate": "tsx --env-file-if-exists=.env scripts/evaluate.ts",
    "dataset:build": "tsx --env-file-if-exists=.env scripts/dataset-build.ts",
    "experiment:run": "tsx --env-file-if-exists=.env scripts/experiment-run.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "bullmq": "^6.3.11",
    "cron-parser": "5.10.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "imapflow": "2.2.5",
    "mailparser": "3.9.36",
    "pg": "^8.23.1",
    "unpdf": "1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/mailparser": "3.9.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
