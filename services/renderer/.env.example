# PubliEXPE Commercial OS - pxos-renderer
# Copia a .env para desarrollo local (pnpm dev).

# Escucha. En desarrollo, solo 127.0.0.1:4030. En el contenedor: HOST=0.0.0.0 PORT=3000
# y SIN puerto publicado al host (solo la red interna pxos-net).
HOST=127.0.0.1
PORT=4030
LOG_LEVEL=info

# Renders simultáneos (1-2). Cada render usa un contexto de navegador nuevo.
RENDER_MAX_CONCURRENCY=2

# Mismas reglas de host que fetch_url en el runtime (dominios separados por comas; cada
# dominio incluye sus subdominios; allowlist vacía = cualquier host público). Las IP
# privadas, loopback y link-local se rechazan siempre, también en cada petición del
# navegador y en cada redirección.
FETCH_URL_ALLOWLIST=
FETCH_URL_DENYLIST=
FETCH_URL_ALLOWED_PORTS=
